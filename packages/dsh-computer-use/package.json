{
  "name": "@cmm/dsh-computer-use",
  "version": "0.1.0",
  "description": "Background computer use for DeepSeek Harness: observe and operate authorized macOS applications while the user keeps focus and the cursor.",
  "license": "MIT",
  "author": "CMM",
  "homepage": "https://github.com/monteromartinchristian-blip/CMMComputerUse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monteromartinchristian-blip/CMMComputerUse.git",
    "directory": "packages/dsh-computer-use"
  },
  "bugs": {
    "url": "https://github.com/monteromartinchristian-blip/CMMComputerUse/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "macos",
    "screencapturekit",
    "accessibility"
  ],
  "type": "module",
  "private": false,
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./runtime": "./runtime.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "runtime.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "adapter/serve.sh",
    "adapter/cmm_computer_use/__init__.py",
    "adapter/cmm_computer_use/client.py",
    "adapter/cmm_computer_use/mcp_server.py",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-manifest.mjs"
  }
}
